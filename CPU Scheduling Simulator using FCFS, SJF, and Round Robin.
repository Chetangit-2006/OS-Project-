
#include <stdio.h>

#define MAX 50

// Structure for Process
struct Process {
    int pid;
    int burst;
    int arrival;
    int waiting;
    int turnaround;
    int remaining;
};

// Function to display results
void display(struct Process p[], int n) {
    float avgWaiting = 0, avgTurnaround = 0;

    printf("\n---------------------------------------------\n");
    printf(" PID\tArrival\tBurst\tWaiting\tTurnaround\n");
    printf("---------------------------------------------\n");

    for (int i = 0; i < n; i++) {
        printf(" P%d\t%d\t%d\t%d\t%d\n",
               p[i].pid,
               p[i].arrival,
               p[i].burst,
               p[i].waiting,
               p[i].turnaround);

        avgWaiting += p[i].waiting;
        avgTurnaround += p[i].turnaround;
    }

    printf("---------------------------------------------\n");
    printf("Average Waiting Time    = %.2f\n", avgWaiting / n);
    printf("Average Turnaround Time = %.2f\n",
           avgTurnaround / n);
}

// FCFS Scheduling
void FCFS(struct Process p[], int n) {
    int time = 0;

    for (int i = 0; i < n; i++) {

        if (time < p[i].arrival)
            time = p[i].arrival;

        p[i].waiting = time - p[i].arrival;

        time += p[i].burst;

        p[i].turnaround = time - p[i].arrival;
    }

    printf("\n===== FCFS Scheduling =====\n");
    display(p, n);
}

// SJF Scheduling
void SJF(struct Process p[], int n) {
    int completed[MAX] = {0};
    int time = 0;
    int count = 0;

    while (count < n) {
        int index = -1;
        int shortest = 9999;

        for (int i = 0; i < n; i++) {

            if (!completed[i] &&
                p[i].arrival <= time &&
                p[i].burst < shortest) {

                shortest = p[i].burst;
                index = i;
            }
        }

        // If no process has arrived
        if (index == -1) {
            time++;
            continue;
        }

        p[index].waiting = time - p[index].arrival;

        time += p[index].burst;

        p[index].turnaround = time - p[index].arrival;

        completed[index] = 1;
        count++;
    }

    printf("\n===== SJF Scheduling =====\n");
    display(p, n);
}

// Round Robin Scheduling
void RoundRobin(struct Process p[], int n, int quantum) {

    int time = 0;
    int completed = 0;

    for (int i = 0; i < n; i++)
        p[i].remaining = p[i].burst;

    while (completed < n) {

        int executed = 0;

        for (int i = 0; i < n; i++) {

            if (p[i].remaining > 0 &&
                p[i].arrival <= time) {

                executed = 1;

                if (p[i].remaining > quantum) {

                    time += quantum;
                    p[i].remaining -= quantum;

                } else {

                    time += p[i].remaining;
                    p[i].remaining = 0;

                    p[i].turnaround =
                        time - p[i].arrival;

                    p[i].waiting =
                        p[i].turnaround - p[i].burst;

                    completed++;
                }
            }
        }

        // CPU idle
        if (!executed)
            time++;
    }

    printf("\n===== Round Robin Scheduling =====\n");
    display(p, n);
}

// Main Function
int main() {

    struct Process original[MAX];
    struct Process temp[MAX];

    int n, choice, quantum;

    printf("====================================\n");
    printf("      CPU SCHEDULING SIMULATOR\n");
    printf("====================================\n");

    printf("Enter number of processes: ");
    scanf("%d", &n);

    for (int i = 0; i < n; i++) {

        original[i].pid = i + 1;

        printf("\nEnter Arrival Time for P%d: ", i + 1);
        scanf("%d", &original[i].arrival);

        printf("Enter Burst Time for P%d: ", i + 1);
        scanf("%d", &original[i].burst);
    }

    do {

        printf("\n\n========== MENU ==========\n");
        printf("1. FCFS\n");
        printf("2. SJF\n");
        printf("3. Round Robin\n");
        printf("4. Exit\n");
        printf("===========================\n");

        printf("Enter your choice: ");
        scanf("%d", &choice);

        // Copy original data
        for (int i = 0; i < n; i++)
            temp[i] = original[i];

        switch (choice) {

            case 1:
                FCFS(temp, n);
                break;

            case 2:
                SJF(temp, n);
                break;

            case 3:
                printf("Enter Time Quantum: ");
                scanf("%d", &quantum);

                RoundRobin(temp, n, quantum);
                break;

            case 4:
                printf("\nProgram terminated.\n");
                break;

            default:
                printf("\nInvalid choice!\n");
        }

    } while (choice != 4);

    return 0;
}
